<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lettore Turni PDF & Timbrature</title>
    <!-- Libreria PDF.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; padding: 16px; display: flex; justify-content: center; }
        .container { width: 100%; max-width: 900px; display: flex; flex-direction: column; gap: 20px; }
        
        header { background-color: #1e293b; padding: 16px; border-radius: 12px; border: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
        header h1 { font-size: 1.25rem; color: #38bdf8; }
        header p { font-size: 0.85rem; color: #94a3b8; }

        .panel { background-color: #1e293b; padding: 20px; border-radius: 12px; border: 1px solid #334155; display: flex; flex-direction: column; gap: 14px; }
        .panel h2 { font-size: 1rem; color: #e2e8f0; }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group label { font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; }

        input, button, select { background-color: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 10px 12px; border-radius: 8px; font-size: 0.9rem; outline: none; }
        input:focus { border-color: #38bdf8; }

        .btn-secondary { background-color: #334155; color: #cbd5e1; font-weight: 600; cursor: pointer; border: none; }

        .dashboard { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
        .card { background-color: #1e293b; padding: 16px; border-radius: 12px; border: 1px solid #334155; }
        .card-label { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; font-weight: 600; }
        .card-value { font-size: 1.5rem; font-weight: 800; margin-top: 4px; }
        .val-planned { color: #f8fafc; }
        .val-worked { color: #38bdf8; }
        .val-positive { color: #34d399; }
        .val-negative { color: #f87171; }

        .table-section { background-color: #1e293b; border-radius: 12px; border: 1px solid #334155; overflow: hidden; }
        .table-header { padding: 16px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
        .table-container { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; }
        th { background-color: #0f172a; color: #94a3b8; padding: 12px 16px; font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid #334155; }
        td { padding: 12px 16px; border-bottom: 1px solid #1e293b; }
        tr:hover { background-color: #334155; }

        #statusMsg { font-size: 0.85rem; color: #38bdf8; margin-top: 6px; }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header -->
        <header>
            <div>
                <h1>Gestione Turni da PDF</h1>
                <p>Carica il file della turnazione e aggiorna le timbrature</p>
            </div>
            <div>
                <input type="month" id="filterMonth">
            </div>
        </header>

        <!-- Configurazione Utente e Caricamento PDF -->
        <div class="panel">
            <h2>1. Il Tuo Profilo e Caricamento Turnazione</h2>
            <div class="grid-2">
                <div class="form-group">
                    <label>Nome e Cognome (come sul PDF)</label>
                    <input type="text" id="userName" placeholder="Es. ROCCHINI ANDREA">
                </div>
                <div class="form-group">
                    <label>Seleziona file PDF Turni</label>
                    <input type="file" id="pdfFile" accept=".pdf">
                </div>
            </div>
            <div id="statusMsg"></div>
        </div>

        <!-- Dashboard Riepilogo -->
        <div class="dashboard">
            <div class="card">
                <div class="card-label">Ore Pianificate</div>
                <div id="totalPlanned" class="card-value val-planned">00:00</div>
            </div>
            <div class="card">
                <div class="card-label">Ore Reali Lavorate</div>
                <div id="totalWorked" class="card-value val-worked">00:00</div>
            </div>
            <div class="card">
                <div class="card-label">Saldo Straordinari</div>
                <div id="totalBalance" class="card-value val-positive">00:00</div>
            </div>
        </div>

        <!-- Tabella Storico Turni -->
        <div class="table-section">
            <div class="table-header">
                <span style="font-weight: 600;">Turni del Mese</span>
                <button class="btn-secondary" onclick="exportCSV()" style="padding: 6px 12px; font-size: 0.75rem;">Esporta CSV</button>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Turno Teorico (PDF)</th>
                            <th>Timbratura Reale (Entrata - Uscita)</th>
                            <th>Ore Reali</th>
                            <th>Saldo</th>
                        </tr>
                    </thead>
                    <tbody id="shiftsTableBody">
                        <tr><td colspan="5" style="text-align: center; color: #64748b; padding: 24px;">Carica un PDF o inserisci i dati per iniziare.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        let shifts = JSON.parse(localStorage.getItem('pdf_shifts_data')) || [];
        const savedName = localStorage.getItem('user_full_name') || '';
        document.getElementById('userName').value = savedName;

        const today = new Date();
        document.getElementById('filterMonth').value = today.toISOString().slice(0, 7);

        document.getElementById('userName').addEventListener('input', (e) => {
            localStorage.setItem('user_full_name', e.target.value.trim());
        });

        document.getElementById('filterMonth').addEventListener('change', render);
        document.getElementById('pdfFile').addEventListener('change', handlePdfUpload);

        async function handlePdfUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const nameInput = document.getElementById('userName').value.trim().toUpperCase();
            if (!nameInput) {
                alert("Inserisci prima il tuo Nome e Cognome.");
                e.target.value = '';
                return;
            }

            const statusMsg = document.getElementById('statusMsg');
            statusMsg.textContent = "Lettura del PDF in corso...";

            try {
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                let fullTextLines = [];

                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const textContent = await page.getTextContent();
                    
                    let currentY = null;
                    let lineStr = "";
                    textContent.items.forEach(item => {
                        let y = Math.round(item.transform[5]);
                        if (currentY === null || Math.abs(y - currentY) > 5) {
                            if (lineStr.trim()) fullTextLines.push(lineStr.trim());
                            lineStr = item.str;
                            currentY = y;
                        } else {
                            lineStr += " " + item.str;
                        }
                    });
                    if (lineStr.trim()) fullTextLines.push(lineStr.trim());
                }

                statusMsg.textContent = `PDF letto con successo! Analisi turni per ${nameInput}...`;
                parseExtractedText(fullTextLines, nameInput);

            } catch (err) {
                console.error(err);
                statusMsg.textContent = "Errore durante la lettura del file PDF.";
            }
        }

        function parseExtractedText(lines, targetName) {
            let foundAny = false;
            lines.forEach((line, index) => {
                if (line.toUpperCase().includes(targetName)) {
                    foundAny = true;
                    for (let j = index; j <= Math.min(index + 4, lines.length - 1); j++) {
                        extractShiftsFromString(lines[j]);
                    }
                }
            });

            if (!foundAny) {
                lines.forEach(line => extractShiftsFromString(line));
            }

            saveAndRender();
            document.getElementById('statusMsg').textContent = "Turni importati con successo dal PDF!";
        }

        function extractShiftsFromString(text) {
            const timeRegex = /(\d{1,2}[:\.]\d{2})\s*[-–to]\s*(\d{1,2}[:\.]\d{2})/g;
            const dateRegex = /(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?/g;
            
            let matchTime;
            let matchDate = dateRegex.exec(text);

            while ((matchTime = timeRegex.exec(text)) !== null) {
                let start = matchTime[1].replace('.', ':');
                let end = matchTime[2].replace('.', ':');
                
                let dateStr = new Date().toISOString().split('T')[0];
                if (matchDate) {
                    let d = matchDate[1].padStart(2, '0');
                    let m = matchDate[2].padStart(2, '0');
                    let y = matchDate[3] ? (matchDate[3].length === 2 ? '20' + matchDate[3] : matchDate[3]) : new Date().getFullYear();
                    dateStr = `${y}-${m}-${d}`;
                }

                const existing = shifts.find(s => s.date === dateStr);
                if (!existing) {
                    shifts.push({
                        id: Date.now().toString() + Math.random(),
                        date: dateStr,
                        planStart: start,
                        planEnd: end,
                        realStart: start,
                        realEnd: end
                    });
                }
            }
        }

        function timeToMinutes(timeStr) {
            if (!timeStr) return 0;
            const parts = timeStr.split(':');
            return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
        }

        function minutesToTime(minutes) {
            const sign = minutes < 0 ? '-' : '';
            const absMin = Math.abs(minutes);
            const h = Math.floor(absMin / 60);
            const m = absMin % 60;
            return `${sign}${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
        }

        function calculateDuration(start, end) {
            let s = timeToMinutes(start);
            let e = timeToMinutes(end);
            if (e < s) e += 24 * 60;
            return e - s;
        }

        window.updateRealTime = function(id, type, value) {
            const shift = shifts.find(s => s.id === id);
            if (shift) {
                if (type === 'start') shift.realStart = value;
                if (type === 'end') shift.realEnd = value;
                saveAndRender();
            }
        };

        function saveAndRender() {
            localStorage.setItem('pdf_shifts_data', JSON.stringify(shifts));
            render();
        }

        function render() {
            const selectedMonth = document.getElementById('filterMonth').value;
            const tbody = document.getElementById('shiftsTableBody');
            tbody.innerHTML = '';

            let totalPlanMin = 0;
            let totalWorkMin = 0;

            const filtered = shifts.filter(s => s.date.startsWith(selectedMonth));
            filtered.sort((a, b) => new Date(a.date) - new Date(b.date));

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: #64748b; padding: 24px;">Nessun turno trovato per questo mese. Carica un PDF valido.</td></tr>`;
            }

            filtered.forEach(s => {
                const planMin = calculateDuration(s.planStart, s.planEnd);
                const workMin = calculateDuration(s.realStart, s.realEnd);
                const diffMin = workMin - planMin;

                totalPlanMin += planMin;
                totalWorkMin += workMin;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight: 600;">${s.date}</td>
                    <td>${s.planStart} - ${s.planEnd}</td>
                    <td>
                        <div style="display: flex; gap: 6px;">
                            <input type="time" value="${s.realStart}" onchange="updateRealTime('${s.id}', 'start', this.value)" style="padding: 4px 8px; font-size: 0.8rem;">
                            <input type="time" value="${s.realEnd}" onchange="updateRealTime('${s.id}', 'end', this.value)" style="padding: 4px 8px; font-size: 0.8rem;">
                        </div>
                    </td>
                    <td style="color: #38bdf8; font-weight: 600;">${minutesToTime(workMin)}</td>
                    <td style="font-weight: 600; color: ${diffMin >= 0 ? '#34d399' : '#f87171'};">${minutesToTime(diffMin)}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('totalPlanned').textContent = minutesToTime(totalPlanMin);
            document.getElementById('totalWorked').textContent = minutesToTime(totalWorkMin);
            
            const totalDiff = totalWorkMin - totalPlanMin;
            const balanceEl = document.getElementById('totalBalance');
            balanceEl.textContent = minutesToTime(totalDiff);
            balanceEl.className = `card-value ${totalDiff >= 0 ? 'val-positive' : 'val-negative'}`;
        }

        function exportCSV() {
            if (shifts.length === 0) {
                alert("Nessun dato da esportare.");
                return;
            }
            let csv = 'Data,Inizio Teorico,Fine Teorico,Inizio Reale,Fine Reale\n';
            shifts.forEach(s => {
                csv += `${s.date},${s.planStart},${s.planEnd},${s.realStart},${s.realEnd}\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', 'turni_estratti.csv');
            a.click();
        }

        render();
    </script>
</body>
</html>
